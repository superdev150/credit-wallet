{
    "name": "superdev150/credit-wallet",
    "description": "Server-side virtual-currency wallet: two balances, an append-only ledger and one-time claims, every change in a transaction. In-memory store for tests, Firestore adapter for production.",
    "type": "library",
    "license": "MIT",
    "keywords": ["wallet", "ledger", "idempotency", "firestore", "in-app-purchases", "virtual-currency"],
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "suggest": {
        "google/cloud-firestore": "Needed by Store\\FirestoreStore"
    },
    "autoload": {
        "psr-4": { "Showcase\\Wallet\\": "src/" }
    },
    "autoload-dev": {
        "psr-4": { "Showcase\\Wallet\\Tests\\": "tests/" }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
